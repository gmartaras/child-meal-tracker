rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read and write their own records.
    // Replace YOUR_EMAIL_ADDRESS with the Google account you sign in with, so that
    // nobody else can store anything in this project even if they find the web address.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && request.auth.token.email == "YOUR_EMAIL_ADDRESS"
                         && request.auth.token.email_verified == true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
