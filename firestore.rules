rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authorised(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['practitioner@example.invalid', 'developer@example.invalid'];
    }
    function operationalCollection(collection) {
      return collection in ['clients', 'sessions', 'foods', 'meta'];
    }
    function clientDeletedTogether(uid, clientId) {
      let client = /databases/$(database)/documents/users/$(uid)/clients/$(clientId);
      return exists(client) && !existsAfter(client);
    }
    match /users/{uid}/{collection}/{recordId} {
      allow read: if authorised(uid) && (operationalCollection(collection) || collection == 'assessments');
      allow create: if authorised(uid) && (operationalCollection(collection) || collection == 'assessments')
        && request.resource.data.id == recordId;
      allow update: if authorised(uid) && request.resource.data.id == recordId
        && (operationalCollection(collection) || (collection == 'assessments' && resource.data.get('state', '') != 'finalised'));
      allow delete: if authorised(uid)
        && (operationalCollection(collection) || (collection == 'assessments'
          && (resource.data.get('state', '') != 'finalised'
            || clientDeletedTogether(uid, resource.data.clientId))));
    }
  }
}
